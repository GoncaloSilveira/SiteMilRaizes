# ─── Resend ───────────────────────────────────────────────────────────────────
# Cria a tua conta gratuita em https://resend.com
# Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email de destino (onde recebes os pedidos de orçamento)
CONTACT_EMAIL=milraizes@milraizes.pt

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Máximo de pedidos por IP por janela de tempo
# Valores por defeito: 3 pedidos / 60 minutos
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=3600000

# ─── Ambiente ─────────────────────────────────────────────────────────────────
# "production" em Vercel, "development" localmente
NODE_ENV=development
